{
  "name": "mosslight-expedition",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:android": "npm run mobile:sync && cap open android",
    "apk:debug": "npm run mobile:sync && cd android && ./gradlew :app:assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "8.6.2",
    "@capacitor/preferences": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/node": "^22",
    "prettier": "^3",
    "typescript": "~6.0.0",
    "vite": "8.3.8"
  }
}
